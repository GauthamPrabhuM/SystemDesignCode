# =========================================================================
# SystemDesignCode — environment variables
# Copy to .env (local) or set in your hosting provider.
# =========================================================================

# ---------- Core ----------
ENV=development

# ---------- Database / cache ----------
# Local docker compose default; in production point at Neon / Upstash.
DATABASE_URL=postgresql+asyncpg://sdc:sdc@postgres:5432/sdc
REDIS_URL=redis://redis:6379/0

# ---------- Auth ----------
# >= 32 chars in production; rotate at least quarterly.
JWT_SECRET=change-me-to-a-long-random-string-32-chars-min
JWT_ALG=HS256
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# OAuth — leave blank to disable that provider
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# JSON array of allowed origins (pydantic-settings v2 requires this format for list fields)
ALLOWED_ORIGINS=["http://localhost:3000"]

# ---------- Quotas ----------
QUOTA_SUBMISSIONS_FREE=50
QUOTA_SUBMISSIONS_PRO=200

# ---------- AI ----------
ANTHROPIC_API_KEY=
AI_REVIEW_MODEL=claude-sonnet-4-5
AI_TRIAGE_MODEL=claude-haiku-4-5

# ---------- Executor ----------
EXECUTOR_RUNTIME=docker
SANDBOX_MEMORY=256m
SANDBOX_CPUS=0.5
SANDBOX_PIDS=64
SANDBOX_TIMEOUT_S=10
SANDBOX_TOTAL_TIMEOUT_S=60

# ---------- Frontend (Next.js) ----------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
